<Window x:Class="ChessGame2.CheckMateForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessGame2"
        mc:Ignorable="d"
        Title="CheckMateForm" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Label  Grid.Row="1" FontSize="55" FontWeight="DemiBold" VerticalContentAlignment="Center" HorizontalAlignment="Center" Content="Check Mate"></Label>
        <Label Grid.Row="2" Content="USER1 WIN" HorizontalContentAlignment="Center" FontSize="40"></Label>

        <Button Grid.Row="3" Width="200" Height="50" Content="Play Again" FontSize="30" HorizontalAlignment="Right" Margin="15"></Button>
        
    </Grid>
</Window>
