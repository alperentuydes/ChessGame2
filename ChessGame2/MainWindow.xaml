<Window x:Class="ChessGame2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessGame2"
        mc:Ignorable="d"
        Title="Chess Game" Height="780" Width="1100" MinWidth="1000" MinHeight="750"
        WindowState="Maximized" Loaded="Window_Loaded">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="750"></ColumnDefinition>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label x:Name="EnemyName" Content="ASDFQERGGGYHYHHY" VerticalAlignment="Center" FontSize="22" FontWeight="Bold"></Label>
                </Grid>

            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="1" Content="8" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                    <Label Grid.Row="2" Content="7" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                    <Label Grid.Row="3" Content="6" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                    <Label Grid.Row="4" Content="5" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                    <Label Grid.Row="5" Content="4" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                    <Label Grid.Row="6" Content="3" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                    <Label Grid.Row="7" Content="2" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                    <Label Grid.Row="8" Content="1" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="A" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                        <Label Grid.Column="1" Content="B" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                        <Label Grid.Column="2" Content="C" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                        <Label Grid.Column="3" Content="D" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                        <Label Grid.Column="4" Content="E" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                        <Label Grid.Column="5" Content="F" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                        <Label Grid.Column="6" Content="G" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                        <Label Grid.Column="7" Content="H" FontSize="25" FontWeight="ExtraBlack" VerticalContentAlignment="Center" HorizontalAlignment="Center"></Label>
                    </Grid>


                    <UniformGrid Grid.Row="1" x:Name="ChessBoardUI" Rows="8" Columns="8"/>
                    <!-- Eşit Kareler Oluşturmamızı Sağlar. -->

                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label x:Name="MyName" Content="ASDFQERGGGYHYHHY" VerticalAlignment="Center" FontSize="22" FontWeight="Bold"></Label>
                </Grid>
            </Grid>

        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="650"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <ListBox Margin="5" x:Name="MessageListBox" BorderBrush="Black" BorderThickness="2" Background="WhiteSmoke"></ListBox>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="😊" Foreground="Blue" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="EmojiHappy" Cursor="Hand"></Button>
                <Button Grid.Column="1" Content="❤️" Foreground="Red" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="EmojiHearth" Cursor="Hand"></Button>
                <Button Grid.Column="2" Content="😘" Foreground="Blue" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="EmojiKiss"  Cursor="Hand"></Button>
                <Button Grid.Column="3" Content="😭" Foreground="Blue" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="EmojiSad" Cursor="Hand"></Button>
            </Grid>

            <Grid Grid.Row="2" Margin="5">

                <TextBox x:Name="MyMessage"
         BorderBrush="Black"
         Padding="8,5" VerticalAlignment="Center"/>

                <TextBlock Text="Mesaj yaz..."
           Foreground="Gray"
           Margin="10,0,0,0"
           VerticalAlignment="Center"
           IsHitTestVisible="False">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">

                            <Setter Property="Visibility"
                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding Text, ElementName=MyMessage}"
                             Value="">

                                    <Setter Property="Visibility"
                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </TextBlock.Style>

                </TextBlock>

            </Grid>
            <Grid Grid.Row="3" Margin="5">

                <Grid.Style>
                    <Style TargetType="Grid">


                        <Style.Triggers>

                            <DataTrigger Binding="{Binding Text, ElementName=MyMessage}"
                         Value="">
                                <Setter Property="Cursor" Value="No"/>
                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </Grid.Style>


                <Button Content="Send">

                    <Button.Style>
                        <Style TargetType="Button">

                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="IsEnabled" Value="True"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding Text, ElementName=MyMessage}"
                             Value="">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Button.Style>

                </Button>

            </Grid>
        </Grid>

    </Grid>
</Window>
