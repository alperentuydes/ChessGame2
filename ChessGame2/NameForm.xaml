<Window x:Class="ChessGame2.NameForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessGame2"
        mc:Ignorable="d"
        Title="NameForm" Height="350" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Label  FontWeight="Bold" FontSize="22" Content="Oyuncu İsmi" VerticalAlignment="Center"></Label>
        <TextBox Grid.Row="1" Margin="15" Background="LightGray" FontSize="19" x:Name="userName"></TextBox>
        <Label Content="IP" Grid.Row="2" FontSize="22"></Label>
        <TextBox Grid.Row="3" Margin="15" Background="LightGray" FontSize="19" x:Name="ip_textbox"></TextBox>
        <Button Grid.Row="4" Width="100" Content="Okey" FontSize="16" HorizontalAlignment="Right" Margin="20" Click="Button_Click"></Button>
    </Grid>
</Window>
