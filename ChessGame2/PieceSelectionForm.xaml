<Window x:Class="ChessGame2.PieceSelectionForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessGame2"
        mc:Ignorable="d"
        Title="PieceSelectionForm" MaxHeight="250" MaxWidth="720"
        MinHeight="250" MinWidth="720"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Label Content="Select Piece" FontSize="30" VerticalAlignment="Center" FontWeight="Black"></Label>
        </Grid>
        <Grid Grid.Row="1" x:Name="GridRows">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <Grid Grid.Column="1" Margin="5" Cursor="Hand" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" x:Name="QueenImage">
                    <!--
                    <Image>
    <Image.Source>
        <BitmapImage DecodePixelWidth="200" UriSource="C:\Users\Casper\source\repos\ChessGame\ChessGame\Assets\Whites\Chess_qlt60.png" />
    </Image.Source>
</Image>
                    -->
                </Border>
                <Label Grid.Row="1" Content="Queen" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"></Label>
            </Grid>




            <Grid Grid.Column="2" Margin="5" Cursor="Hand" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" x:Name="BishopImage">
                    <Image>
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="200" UriSource="C:\Users\Casper\source\repos\ChessGame\ChessGame\Assets\Whites\Chess_blt60.png" />
                        </Image.Source>
                    </Image>
                </Border>
                <Label Grid.Row="1" Content="Bishop" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"></Label>
            </Grid>




            <Grid Grid.Column="3" Margin="5" Cursor="Hand" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" x:Name="KnightImage">
                    <Image>
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="200" UriSource="C:\Users\Casper\source\repos\ChessGame\ChessGame\Assets\Whites\Chess_nlt60.png" />
                        </Image.Source>
                    </Image>
                </Border>
                <Label Grid.Row="1" Content="Knight" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"></Label>
            </Grid>




            <Grid Grid.Column="4" Margin="5" Cursor="Hand" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" x:Name="RookImage">
                    <Image>
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="200" UriSource="C:\Users\Casper\source\repos\ChessGame\ChessGame\Assets\Whites\Chess_rlt60.png" />
                        </Image.Source>
                    </Image>
                </Border>
                <Label Grid.Row="1" Content="Rook" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"></Label>
            </Grid>
        </Grid>




        <Grid Grid.Row="2">
            <Button Width="100" Height="40" Content="Okey" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0 0 10 0" Click="Button_Click"></Button>
        </Grid>

    </Grid>
</Window>
